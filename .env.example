# ==============================================================================
# CloudNotes — Environment Configuration
# ==============================================================================

# Your Google OAuth 2.0 Client ID for Web Applications (obtained from Google Cloud Console)
# Note: A public client ID used in browser-based Single Page Applications is NOT a secret.
# Authorized JavaScript Origins in GCP must match your local dev URL (e.g. http://localhost:5173)
# and your production deployment domain.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional: Default target folder name in Google Drive (defaults to 'CloudNotes')
VITE_DRIVE_FOLDER_NAME=CloudNotes
